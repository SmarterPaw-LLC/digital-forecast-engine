# Google Drive upload staging — Drive creates this folder while syncing other
# files on the machine; zlib-compressed binary chunks with numeric names. Not
# part of the project. Drive usually cleans it up itself when uploads finish.
.tmp.driveupload/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Local-only / scratch
*.log
*.tmp
.env
.env.local

# stray Windows shortcuts
*.lnk

# Test-harness data dumps — regenerated on every run, duplicate repo content
tests/*_cases.json
tests/*_guard.json

# One-off patch / fix scripts run against index.html. Scratch by nature, and
# two Claude sessions working this repo at once were sweeping each other's
# in-progress scripts into commits via `git add -A`. Keep them on disk,
# out of git. (tests/ is deliberately NOT ignored - those are the suites.)
/patch_*.py
/fix_*.py
/doc_v*.py
